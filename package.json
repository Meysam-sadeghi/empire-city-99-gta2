{
  "name": "empire-city-99",
  "version": "1.0.0",
  "private": false,
  "license": "MIT",
  "description": "Empire City '99 — Open-source 2.5D top-down open-world action game inspired by GTA 2 (1999) built with TypeScript, Three.js, Rapier2D WASM, React, and Web Audio API.",
  "keywords": [
    "gta2",
    "gta-clone",
    "open-world",
    "threejs",
    "typescript",
    "rapier2d",
    "browser-game",
    "web-game",
    "2.5d",
    "web-audio-api"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/Meysam-sadeghi/empire-city-99-gta2.git"
  },
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0 --port 5173",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host 0.0.0.0 --port 4173",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@dimforge/rapier2d-compat": "^0.14.0",
    "lucide-react": "^0.468.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "three": "^0.170.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.1",
    "@tailwindcss/vite": "^4.0.0",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@types/three": "^0.170.0",
    "@vitejs/plugin-react": "^4.3.4",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.7.2",
    "vite": "^6.0.5"
  }
}
